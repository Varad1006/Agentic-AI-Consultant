# Required: create a key at https://console.groq.com/keys
GROQ_API_KEY=

# Optional overrides (defaults shown)
GROQ_MODEL=openai/gpt-oss-120b
# low | medium | high. Higher effort = better reasoning, more tokens.
GROQ_REASONING_EFFORT=medium
# Characters of the document the Business Analyst reads. Groq's free tier allows 8K tokens/min,
# so keep ~12000 there; raise it (e.g. 60000) on a paid plan.
MAX_CONTEXT_CHARS=12000
MAX_UPLOAD_MB=10
